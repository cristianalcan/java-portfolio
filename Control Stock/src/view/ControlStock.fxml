<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="409.0" prefWidth="611.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ControlStockController">
   <children>
      <Button fx:id="buttonAgregar" layoutX="50.0" layoutY="339.0" mnemonicParsing="false" onAction="#agregar" style="-fx-background-color: grey;" text="Agregar" textFill="WHITE" />
      <Button fx:id="buttonModificar" layoutX="140.0" layoutY="339.0" mnemonicParsing="false" onAction="#modificar" style="-fx-background-color: grey;" text="Modificar" textFill="WHITE" />
      <TableView fx:id="tabla" layoutX="232.0" layoutY="36.0" prefHeight="317.0" prefWidth="356.0">
        <columns>
          <TableColumn prefWidth="120.0" text="Identificador" />
          <TableColumn prefWidth="124.0" text="Nom. Producto" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <Label layoutX="37.0" layoutY="35.0" prefHeight="17.0" prefWidth="103.0" text="Identificador" />
      <TextField fx:id="textoIdentificador" layoutX="37.0" layoutY="67.0" />
      <Label layoutX="42.0" layoutY="130.0" prefHeight="17.0" prefWidth="115.0" text="Nombre Producto" />
      <Label layoutX="50.0" layoutY="228.0" prefHeight="17.0" prefWidth="49.0" text="Stock" />
      <TextField fx:id="textoProducto" layoutX="37.0" layoutY="169.0" />
      <TextField fx:id="textoStock" layoutX="37.0" layoutY="265.0" prefHeight="25.0" prefWidth="164.0" />
   </children>
</AnchorPane>
